# Copy to secrets.env (gitignored) and fill in the keys you have. A variable
# already set in the environment wins over this file. With
# active_provider: auto, the first provider in settings.yaml with a key is used
# (free ones are listed first).

# --- free ---
# https://bigmodel.cn  (sign up, console -> API keys). Model glm-4.7-flash is free.
ZHIPU_API_KEY=
# https://aistudio.google.com/apikey  (free tier, rate-limited)
GEMINI_API_KEY=
# https://openrouter.ai/keys  (":free" models; 50 requests/day without credit)
OPENROUTER_API_KEY=
# Alibaba Cloud Model Studio (new-user free quota)
DASHSCOPE_API_KEY=

# --- paid ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
